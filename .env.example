# StudyMate Classroom Environment Configuration Template
# For production deployment on Vercel, populate these variables in Project Settings -> Environment Variables.

# Firebase Web Configuration
FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Google Gemini API Key (for Grounded Note Summaries, Practice Question Recommendations, and AI Rubric Feedback)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Live Class & Meeting Provider Configuration
# Supported providers: Jitsi Meet (default, free, zero-config), Google Meet (OAuth)
LIVE_CLASS_DEFAULT_PROVIDER=jitsi

